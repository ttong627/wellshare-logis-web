rules_version = '2';

// Firebase Storage 보안 규칙 — wellshare-logis
//   · rosters/**        : 회원사 공유 명단(동대문·여주 등). 다운로드=로그인 사용자, 업로드/삭제=관리자.
//   · rosters_admin/**  : 본사 관리자 전용 명단(부천 메일함 등). 열람·다운로드·쓰기 모두 관리자만.
//   · 그 외(doc_images, refine-handoff 등): 기존대로 로그인 사용자 읽기/쓰기.
//   ⚠️ Storage 규칙은 매칭되는 규칙 중 하나라도 허용하면 통과(OR) → 광역 규칙이 rosters 계열을
//      덮어 권한이 새지 않도록, 광역 규칙에서 rosters/rosters_admin 경로를 명시적으로 제외한다.
//   ⚠️ 2026-07-11 실사고: {allPaths=**}는 path 타입이라 .matches()(string 전용)를 쓰면 타입
//      오류로 항상 거부된다(광역 규칙 전체가 막혀 refine-handoff 업로드 실패) — 첫 세그먼트만
//      떼어 문자열 비교로 수정. path 세그먼트가 1개뿐인 루트 객체도 대비해 두 형태 모두 둔다.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() { return request.auth != null; }
    function isAdminEmail() {
      return isSignedIn() && (
        request.auth.token.email == 'ttong@wssc.kr' ||
        request.auth.token.email == 'ttong627@gmail.com' ||
        request.auth.token.email == 'goodp1@hanmail.net'
      );
    }

    // 회원사 공유 명단(PII) — **자기 담당 지역만** 다운로드. 업로드/삭제=관리자만.
    //   경로가 `rosters/{지역}/…` 이라 지역으로 판정한다(파일에는 회사 정보가 없다).
    //   회사↔지역 매핑은 Firestore `master_settings.partnerRegions` 가 SSOT —
    //   Storage 규칙은 firestore.get() 으로 그걸 읽는다. 클라이언트 상수는 못 읽는다.
    //   ⚠️2026-08-13 실측: 이 규칙이 `isSignedIn()` 이던 동안, `adminOnly:true` 로 표시된
    //     수원시 명단 2건의 **파일이 공개 경로에 있어 회원사도 받을 수 있었다**(화면에서만 숨겨져 있었다).
    //     수원시는 담당 회사가 없으므로 아래 규칙에서 자동으로 관리자 전용이 된다.
    match /rosters/{region}/{allPaths=**} {
      allow read: if isAdminEmail() || regionAllowed(region);
      allow write: if isAdminEmail();
    }
    // 지역 폴더가 없는 루트 직하 파일(구 데이터 대비) — 관리자만.
    match /rosters/{onlyFile} {
      allow read, write: if isAdminEmail();
    }

    function myCompany() {
      return isSignedIn()
        ? firestore.get(/databases/(default)/documents/artifacts/wellshare-logis-v1-production-stable/public/data/settings/master_settings)
            .data.get('partnerAccounts', {}).get(request.auth.token.email, '')
        : '';
    }
    function regionAllowed(region) {
      return isSignedIn()
        && firestore.get(/databases/(default)/documents/artifacts/wellshare-logis-v1-production-stable/public/data/settings/master_settings)
             .data.get('partnerRegions', {}).get(myCompany(), []).hasAny([region]);
    }

    // 관리자 전용 명단 — 본사 관리자만 열람/다운로드/쓰기(회원사 완전 차단).
    match /rosters_admin/{allPaths=**} {
      allow read, write: if isAdminEmail();
    }

    // 그 외 경로(doc_images, refine-handoff 등) — 로그인 사용자. rosters 계열은 위 전용 규칙만 적용.
    match /{first}/{rest=**} {
      allow read, write: if isSignedIn() && first != 'rosters' && first != 'rosters_admin';
    }
    match /{first} {
      allow read, write: if isSignedIn() && first != 'rosters' && first != 'rosters_admin';
    }
  }
}
