# 카카오 개발자 콘솔 (https://developers.kakao.com) 에서 발급
VITE_KAKAO_JS_KEY=your_kakao_js_key
VITE_KAKAO_REST_KEY=your_kakao_rest_key

# Firebase 프로젝트 설정 (https://console.firebase.google.com)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# 명단정제시스템(nexus-pipeline) 연동 — 명단 탭 "정제된 명단 받기"/"명단 정제하기"
VITE_ADDRESS_MATCH_API_URL=https://nexus-address-api-xxxxxxxxx.asia-northeast3.run.app
VITE_REFINE_SYSTEM_URL=https://logis-op.web.app
