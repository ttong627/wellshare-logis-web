rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 기본 차단 ─────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ── 공통 헬퍼 ────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // 서버사이드 관리자 이메일 검증 (클라이언트 코드 우회 불가)
    function isAdminEmail() {
      return isSignedIn() && (
        request.auth.token.email == 'ttong@wssc.kr' ||
        request.auth.token.email == 'ttong627@gmail.com' ||
        request.auth.token.email == 'goodp1@hanmail.net'
      );
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ROLE_ADMIN';
    }

    function isEditor() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ROLE_EDITOR';
    }

    // settings.partnerAccounts[email]=='ADMIN' 으로 동적 지정된 관리자 (앱 useAuth와 일치)
    function isDynamicAdmin(appId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/settings/master_settings)
        && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/settings/master_settings)
             .data.get('partnerAccounts', {}).get(request.auth.token.email, '') == 'ADMIN';
    }
    // 이메일 하드코딩 관리자 OR 동적 관리자
    function isAdminUser(appId) {
      return isAdminEmail() || isDynamicAdmin(appId);
    }

    // 로그인 사용자의 소속 회원사명. 관리자는 'ADMIN'.
    //   partnerAccounts[email] = 회사명 | 'ADMIN' (앱 useAuth 와 동일 출처)
    function myCompany(appId) {
      return (isSignedIn()
              && exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/settings/master_settings))
        ? get(/databases/$(database)/documents/artifacts/$(appId)/public/data/settings/master_settings)
            .data.get('partnerAccounts', {}).get(request.auth.token.email, '')
        : '';
    }

    // ── wellshare-logis-web 메인 앱 데이터 ───────────────────────────────
    // artifacts/{appId}/public/data/** 경로
    //   ⚠️Firestore 는 **매칭되는 규칙 중 하나라도 허용하면 통과(OR)** 다. 아래 rosters 전용
    //     규칙을 아무리 좁혀도 이 광역 규칙이 먼저 허용해 버리면 소용이 없다 →
    //     여기서 `rosters` 를 **명시적으로 제외**한다. (Storage 규칙이 rosters 를 제외한 것과 같은 이유)
    //   ⛔전용 규칙을 두는 컬렉션은 **여기서 반드시 빼야 한다.** 한 번 빠뜨려서
    //     `access_logs` 의 append-only(`update, delete: if false`)가 무력화됐다 —
    //     이 광역 규칙의 `allow write: if isAdminEmail()` 이 먼저 허용해 관리자가 기록을
    //     지울 수 있었고, `allow read: if isSignedIn()` 때문에 회원사가 남의 열람기록도 읽었다.
    //     (2026-08-14 시뮬레이터가 잡음 — 규칙만 읽어서는 안 보이는 종류의 결함이다)
    //   ⚠️2026-08-14 2차: `pushTokens`(본인 uid 만)·`notifications`(ADMIN 대상은 관리자만) 전용
    //     규칙도 같은 이유로 무력화돼 있었다 — 회원사 계정이 남의 FCM 토큰·관리자 알림을 광역 read
    //     로 볼 수 있었다. 전면 점검 시뮬레이터가 잡았다. **전용 규칙 컬렉션은 전부 이 목록에 넣는다.**
    match /artifacts/{appId}/public/data/{coll}/{document=**} {
      // 인증된 사용자 전체 읽기 허용 (전용 규칙이 있는 컬렉션은 전부 제외)
      allow read: if isSignedIn()
        && !(coll in ['rosters', 'access_logs', 'pushTokens', 'notifications', 'billing_records', 'billing_admin']);
      // 쓰기는 관리자 이메일만 (서버사이드 검증)
      allow write: if isAdminEmail()
        && !(coll in ['rosters', 'access_logs', 'pushTokens', 'notifications', 'billing_records', 'billing_admin']);
    }

    // 열람기록(access_logs) — 누가 명단을 받아갔는지. **추가만 되고 고치거나 지울 수 없다.**
    //   ★기록이 조용히 사라질 수 있으면 감사 자료로서 값이 없다 → update·delete 는 아예 막는다.
    //     (관리자도 못 지운다. 지워야 할 일이 생기면 서버 admin SDK 로 한다 — 흔적이 남는 경로다)
    //   ★읽기는 관리자만. 열람기록 자체가 "누가 어느 지자체를 담당하나" 같은 정보를 담는다.
    //   ★본인 것만 쓸 수 있게 uid·email 을 대조한다 — 남의 이름으로 기록을 심어
    //     감사 자료를 오염시키는 것을 막는다.
    match /artifacts/{appId}/public/data/access_logs/{logId} {
      allow read: if isAdminUser(appId);
      //   ⚠️`at` 은 문자열(ISO)로 저장한다(경보 함수가 문자열 비교로 창을 자른다). 다만
      //     규칙에서 `is string` 만 걸면 **시뮬레이터가 ISO 문자열을 timestamp 로 바꿔** 넣어
      //     거부된다(2026-08-14 실측). 어느 쪽이 와도 통과시키되 존재는 강제한다 —
      //     타입 강제는 보안이 아니라 정합성 목적이고, 여기서 막히면 기록이 통째로 안 남는다.
      allow create: if isSignedIn()
        && incoming().uid == request.auth.uid
        && incoming().email == request.auth.token.email
        && (incoming().at is string || incoming().at is timestamp)
        && incoming().kind is string;
      allow update, delete: if false;
    }

    // 명단(rosters) — 수급자 개인정보(PII). **회원사는 자기 회사가 지정된 것만.**
    //   ★`allowedCompanies` 는 전 문서에 채워져 있다(scripts/backfill-roster-companies.py).
    //     빈 배열 `[]` = 관리자 전용. 예전의 "필드 없으면 지역으로 판단" 폴백은 없다.
    //   ★앱은 회원사일 때 `where('allowedCompanies','array-contains', 내회사)` 로 질의해야 한다.
    //     전체 목록 질의는 이 규칙 아래에서 **통째로 거부**된다(Firestore 는 부분 결과를 안 준다).
    match /artifacts/{appId}/public/data/rosters/{rosterId} {
      allow read: if isAdminUser(appId)
        || (isSignedIn()
            && existing().get('adminOnly', false) != true
            && existing().get('allowedCompanies', []).hasAny([myCompany(appId)]));
      allow write: if isAdminEmail();
    }

    // billing_records 부모: **공통 필드만** 남는다(zonePrices·regions·orders·isClosed·version).
    //   회사별 정산(partnerInputs 등)은 아래 서브컬렉션으로 격리. 공통은 비민감이라 인증자 read 허용.
    //   ★2026-08 billing 회사별 격리: 회원사끼리 서로 정산을 못 보게 문서를 회사=서브독ID 로 쪼갰다.
    match /artifacts/{appId}/public/data/billing_records/{monthId} {
      allow read: if isSignedIn();
      allow write: if isAdminUser(appId);   // 공통 필드는 관리자만
    }

    // 회사별 서브컬렉션 — 회사=문서ID 로 **실격리**(read·write 모두 회사 단위).
    //   publishRequests(관리자→회원사 발행요청): 자기 회사 read·관리자만 write(스푸핑 차단).
    match /artifacts/{appId}/public/data/billing_records/{monthId}/publishRequests/{company} {
      allow read: if isAdminUser(appId) || myCompany(appId) == company;
      allow write: if isAdminUser(appId);
    }
    //   나머지(partnerInputs·deliveryDates·publishDates): 자기 회사 read/write. 마감월은 회원사 쓰기 차단.
    //   ★부모 월 문서가 아직 없으면(새 달 — 관리자가 공통 필드를 저장하기 전) `exists` 가드로 통과시킨다.
    //     가드 없이 get() 하면 **문서 없음 = 평가 에러 = 전부 거부**라, 매달 초 회원사 저장이
    //     통째로 막힌다(2026-08-19 실증: 7월 마감 직후 8월 부모 생성 전 폰 저장 전멸).
    match /artifacts/{appId}/public/data/billing_records/{monthId}/{field}/{company} {
      allow read: if isAdminUser(appId) || myCompany(appId) == company;
      allow write: if field != 'publishRequests'
        && (isAdminUser(appId)
            || (myCompany(appId) == company
                && (!exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/billing_records/$(monthId))
                    || get(/databases/$(database)/documents/artifacts/$(appId)/public/data/billing_records/$(monthId))
                         .data.get('isClosed', false) != true)));
    }

    // ecountSales(회사별 ECOUNT 발행내역·민감) — 관리자 전용(회원사 노출 차단, 08-14 이전).
    match /artifacts/{appId}/public/data/billing_admin/{monthId} {
      allow read, write: if isAdminUser(appId);
    }

    // master_settings: 계정 승인·권한 관리(partnerAccounts/pendingUsers)는 동적 관리자(ROLE ADMIN)도 가능.
    // 그 외 설정 전체 쓰기는 상위 {document=**} 규칙대로 하드코딩 관리자만.
    match /artifacts/{appId}/public/data/settings/master_settings {
      allow read: if isSignedIn();
      allow update: if isAdminUser(appId)
        && incoming().diff(existing()).affectedKeys()
             .hasOnly(['partnerAccounts', 'pendingUsers', 'updatedAt', 'updatedBy']);
    }

    // 앱 버전(강제 업데이트 게이트): 공개 읽기(로그인 전에도 버전 확인 가능), 쓰기는 관리자만.
    match /artifacts/{appId}/public/data/settings/app_version {
      allow read: if true;
      allow write: if isAdminEmail();
    }

    // 알림: 내 타겟만 읽기 / 타겟별 생성 검증 / 읽음(readBy)만 수정 / 삭제는 관리자만
    match /artifacts/{appId}/public/data/notifications/{notifId} {
      // ADMIN 알림은 관리자만 읽음(파트너→관리자 알림 노출 차단). 회사 알림은 인증자 읽기
      allow read: if isSignedIn() && (existing().target == 'ADMIN' ? isAdminEmail() : true);
      // 생성: 형식 검증 + 특정 회사 지정(target!=ADMIN)은 관리자만(스푸핑 차단)
      allow create: if isSignedIn()
        && incoming().message is string && incoming().message.size() <= 500
        && incoming().target is string && incoming().target.size() <= 100
        && incoming().timestamp is string
        && (incoming().target == 'ADMIN' || isAdminUser(appId));
      // 읽음처리: readBy 필드만 변경 가능
      allow update: if isSignedIn()
        && incoming().diff(existing()).affectedKeys().hasOnly(['readBy']);
      // 하드 삭제는 관리자만 (파트너는 읽음처리로 정리)
      allow delete: if isAdminUser(appId);
    }

    // 푸시 토큰: 본인(uid) 문서만 본인이 생성/수정. 읽기는 본인 또는 관리자.
    // 발송은 Cloud Function이 admin SDK로 수행(규칙 우회)하므로 클라이언트 광범위 읽기 불필요.
    match /artifacts/{appId}/public/data/pushTokens/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdminUser(appId));
      allow create, update: if isSignedIn() && request.auth.uid == uid
        && incoming().token is string && incoming().token.size() <= 4096
        && incoming().target is string && incoming().target.size() <= 100;
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAdminUser(appId));
    }

    // ── 테스트 연결 ──────────────────────────────────────────────────────
    match /test/connection {
      allow read: if true;
    }

    // ── ttong 프로젝트 컬렉션 (기존 규칙 유지) ───────────────────────────

    match /drivers/{driverId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(driverId) && isValidDriver(incoming(), true);
      allow update: if isSignedIn() && isValidDriver(incoming(), false) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['id', 'name', 'phone', 'emergency', 'updatedAt'])
      );
      allow delete: if isSignedIn();
    }

    function isValidDriver(data, isCreate) {
      return (!isCreate || data.keys().hasAll(['id', 'name'])) &&
             (!('id' in data)        || (data.id is string && data.id.size() <= 128)) &&
             (!('name' in data)      || (data.name is string && data.name.size() <= 100)) &&
             (!('phone' in data)     || (data.phone is string && data.phone.size() <= 100)) &&
             (!('emergency' in data) || (data.emergency is string && data.emergency.size() <= 100)) &&
             (!('updatedAt' in data) || (data.updatedAt is string));
    }

    match /schedules/{scheduleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(scheduleId) && isValidSchedule(incoming(), true);
      allow update: if isSignedIn() && isValidSchedule(incoming(), false) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['items', 'lastUpdated', 'year', 'month', 'sido', 'sigungu'])
      );
      allow delete: if isSignedIn();
    }

    function isValidSchedule(data, isCreate) {
      return (!isCreate || data.keys().hasAll(['year', 'month', 'items'])) &&
             (!('year' in data)        || data.year is number) &&
             (!('month' in data)       || data.month is number) &&
             (!('items' in data)       || (data.items is list && data.items.size() <= 2000)) &&
             (!('lastUpdated' in data) || (data.lastUpdated is string));
    }

    match /officialDocs/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(docId);
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(settingId);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming(), true);
      allow update: if isSignedIn() && (
        (request.auth.uid == userId &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'photoUrl', 'lastActive', 'pushToken', 'displayName', 'lastLoginAt']) &&
          isValidUser(incoming(), false)) ||
        (isAdmin() && isValidUser(incoming(), false))
      );
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    function isValidUser(data, isCreate) {
      return (!isCreate || data.keys().hasAll(['uid', 'email'])) &&
             (!('uid' in data)         || data.uid is string) &&
             (!('email' in data)       || data.email is string) &&
             (!('role' in data)        || data.role is string) &&
             (!('status' in data)      || data.status is string) &&
             (!('displayName' in data) || data.displayName is string) &&
             (!('createdAt' in data)   || data.createdAt is string) &&
             (!('lastLoginAt' in data) || data.lastLoginAt is string);
    }

    match /invites/{inviteId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn() && (isAdmin() || isEditor());
      allow update: if isSignedIn();
    }

    match /emergencyContacts/{contactId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidEmergencyContact(incoming());
      allow update: if isSignedIn() && isValidEmergencyContact(incoming());
      allow delete: if isSignedIn() && (isAdmin() || isEditor());
    }

    function isValidEmergencyContact(data) {
      return data.keys().hasAll(['sido', 'sigungu', 'phone']) &&
             data.sido is string && data.sido.size() <= 100 &&
             data.sigungu is string && data.sigungu.size() <= 100 &&
             data.phone is string && data.phone.size() <= 100;
    }
  }
}
